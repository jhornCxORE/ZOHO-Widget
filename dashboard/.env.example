# "mock" serves generated sample data (no credentials needed).
# "live" calls the real Zoho CRM and Books APIs.
DATA_MODE=mock

PORT=3001

# Zoho data center your account lives in: com | eu | in | com.au | jp | ca | sa | com.cn
ZOHO_DC=com

# From a "Server-based Application" client at https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Generate with: npm run zoho:token
ZOHO_REFRESH_TOKEN=

# Zoho Books organization ID (Books > Settings > Organization Profile)
ZOHO_BOOKS_ORG_ID=

# How long API results are cached on the server, in seconds
CACHE_TTL_SECONDS=300

# Enables the /api/zoho passthrough used by the API tester page.
# Defaults to on outside production. Never enable on a public deployment.
ENABLE_API_TESTER=
